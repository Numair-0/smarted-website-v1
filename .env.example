# Copy to .env.local for local development. None of these are required
# for the site to run — they only activate optional integrations.

# --- Contact form email delivery (optional) ---
# Wire this into src/app/api/contact/route.ts once you pick a provider.
# Example shown for Resend (https://resend.com):
# RESEND_API_KEY=

# --- Site URL override (optional) ---
# Defaults to the production domain in src/lib/site-config.ts.
# Set this in preview/staging environments if the domain differs.
# NEXT_PUBLIC_SITE_URL=
